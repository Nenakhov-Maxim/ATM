# Виртуальное окружение uv (обычно .venv)
.venv/

# Lock-файл uv — фиксирует точные версии, не нужен в репо (воспроизводится на любой машине)
uv.lock
requirements.txt

# Кэш uv (может быть в ~/.cache/uv, но если у тебя локальный кэш рядом — тоже лучше игнорировать)
.uv-cache/

# Стандартные Python-артефакты
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Файлы переменных окружения (секреты, ключи)
.env
.env.local
.env.*

# Локальные конфиги, которые не должны улетать в репо
local_settings.py

# Медиа и статика, если они генерируются/загружаются на сервере
/media/
/static/

# Логи и временные файлы
*.log
*.tmp
*.temp
tmp/
.DS_Store
